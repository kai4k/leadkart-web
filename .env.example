# Private server-side environment configuration.
#
# Copy to .env.local for local development. Production reads from the
# deployment environment (Render/Fly/Vercel/K8s — never check secrets in).
#
# Validation: src/lib/server/config.ts validates every key with Zod when
# the server starts (the init hook). A missing or malformed value stops the
# BFF with a diagnostic pointing at the offending key. README.md
# "Deployment" has the same list.

# ─── Required ────────────────────────────────────────────────────────

# URL the SvelteKit BFF uses to reach the Go API server-to-server.
#   - Dev:        http://localhost:8080 (local Go server)
#   - Test (e2e): http://localhost:9999 (mock Go server from playwright.config.ts)
#   - Prod:       internal service URL (e.g. http://go-api:8080 in K8s)
# Must NOT be a public URL — Go is never internet-facing in this topology.
GO_API_URL=http://localhost:8080

# HMAC key signing the operator-scope cookie (lk_op_tenant), 32+ chars.
# `npm run dev` needs no secret (it falls back to a public dev-only key);
# EVERY built server (preview, e2e, production) requires one or refuses to start.
# Generate with: openssl rand -base64 48
# NODE_ENV=production rejects the published e2e (e2e-only...) and dev secrets.
# SCOPE_COOKIE_SECRET=

# ─── Environment ─────────────────────────────────────────────────────

# Drives cookie Secure flag and the access-cookie name:
#   - 'production'         → Secure=true, name '__Host-lk_access' (HTTPS)
#   - 'development'|'test' → Secure=false, name 'lk_access' (HTTP)
# FAILS CLOSED: unset means 'production' for a built server. `npm run dev`
# defaults to 'development' itself; playwright sets 'test'.
NODE_ENV=development

# ─── Optional ────────────────────────────────────────────────────────

# Timeout (ms) for every BFF -> Go request. Default 10000.
# UPSTREAM_TIMEOUT_MS=10000

# Public origin used for the absolute link-preview URLs (og:url, og:image, twitter:image) written by
# src/app.html. REQUIRED in production (the server refuses to start without it): a preview crawler ignores a
# relative image URL. The value is empty or exactly an origin: https (http only outside production), no path,
# NO trailing slash, no credentials, no query or fragment (`https://app.example.com`, not `https://app.example.com/`).
# Dev: leave empty, the URLs degrade to root-relative.
PUBLIC_SITE_URL=

# ─── adapter-node (read by the Node server at runtime) ───────────────

# Public origin of the app. Must be https in production. Production
# REQUIRES ORIGIN or both PROTOCOL_HEADER and HOST_HEADER (the server refuses
# to start otherwise): without one, SvelteKit's origin check rejects every
# form action (sign-in included) with 403 behind a TLS-terminating proxy.
# ORIGIN=https://app.example.com
#
# WARNING: set PROTOCOL_HEADER / HOST_HEADER ONLY when a trusted reverse
# proxy overwrites those headers on every request. Otherwise clients can
# spoof them and forge the origin.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
#
# Client IP behind a proxy (same trusted-proxy rule as above). The BFF sends it to Go as
# X-Forwarded-For (Go rate-limits login / refresh / reset per address) and Go must list the BFF's
# address in LEADKART_HTTP__TRUSTED_PROXIES. adapter-node reads addresses[length - XFF_DEPTH] of
# X-Forwarded-For, counted from the right (the end the proxies append to). XFF_DEPTH must equal,
# never exceed, the number of proxies in front of the BFF that append to X-Forwarded-For (leave both
# unset when nothing sits in front). Too small reads a proxy's own hop: every user shares one
# address (anyone can lock everyone out of login). Too large reads hops the client wrote: the
# address is client-spoofable.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
#
# Listen port (default 3000) and maximum request body (default 512K).
# PORT=3000
# BODY_SIZE_LIMIT=512K
