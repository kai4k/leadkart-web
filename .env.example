# Private server-side environment configuration.
#
# Copy to .env.local for local development. Production reads from the
# deployment environment (Render/Fly/Vercel/K8s — never check secrets in).
#
# Validation: src/lib/server/config.ts validates every key with Zod at
# server boot. A missing or malformed value crashes the BFF with a
# diagnostic pointing at the offending key — no "undefined/api/v1/..."
# mystery in production logs.

# ─── Required ────────────────────────────────────────────────────────

# URL the SvelteKit BFF uses to reach the Go API server-to-server.
#   - Dev:        http://localhost:8080 (local Go server)
#   - Test (e2e): http://localhost:9999 (mock Go server from playwright.config.ts)
#   - Prod:       internal service URL (e.g. http://go-api:8080 in K8s)
# Must NOT be a public URL — Go is never internet-facing in this topology.
GO_API_URL=http://localhost:8080

# ─── Optional (Node auto-sets) ───────────────────────────────────────

# Drives cookie Secure flag and the access-cookie name:
#   - 'production'         → Secure=true, name '__Host-lk_access' (HTTPS)
#   - 'development'|'test' → Secure=false, name 'lk_access' (HTTP)
# Default 'development' if unset.
NODE_ENV=development
