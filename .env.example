# Private env vars (server-side only — NOT exposed to the browser).
# Copy to .env.local and fill in your values.

# URL the SvelteKit BFF uses to reach the Go API server-to-server.
# In dev this is the local Go server. In production this is the
# internal service URL (e.g. http://go-api:8080 in a K8s cluster).
# NEVER set this to a public URL — the Go API should not be internet-facing.
GO_API_URL=http://localhost:8080

# NODE_ENV controls cookie security flags. Set to 'production' in prod.
# (Automatically set by Node; include here for documentation only.)
NODE_ENV=development
