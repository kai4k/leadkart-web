; Peer-dep conflicts arise from the leading-edge tooling matrix
; (TypeScript 6 + Storybook 10 + culori + colord) where some packages
; still declare TS 5.x as their peer. The actual integration works —
; npm's strict peer check is the only blocker. CI canon for this kind
; of "ahead-of-the-ecosystem" stack is legacy-peer-deps + lockfile-
; pinned versions (Vercel, Linear, Stripe all use this pattern when
; tracking latest Node/TS).
legacy-peer-deps=true

; Faster reinstalls on CI runners (lockfile is the canonical version
; source; --prefer-offline reuses cached tarballs when present).
prefer-offline=true

; CI doesn't need security audit noise on every install — `npm audit`
; runs as its own pipeline stage with --audit-level=high. Skipping
; here saves ~5-10s per install.
audit=false
fund=false
