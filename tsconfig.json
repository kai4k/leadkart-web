{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"vite.config.ts",
		"vitest.config.ts",
		"playwright.config.ts"
	],
	"exclude": [
		"**/*.stories.ts",
		"**/*.stories.svelte",
		".storybook/**",
		"storybook-static/**",
		"src/service-worker/**",
		"node_modules/**",
		"build/**"
	]
}
