{
	"name": "leadkart-web",
	"description": "LeadKart SaaS web frontend — Svelte 5 + SvelteKit 3 + Tailwind 4, adapter-node BFF targeting the leadkart-go JSON API.",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview:e2e": "NODE_ENV=test SCOPE_COOKIE_SECRET=e2e-only-scope-cookie-secret-0123456789abcdef ORIGIN=http://localhost:4173 PORT=4173 node build/index.js",
		"test:mock-server": "node tests/e2e/mock-server/server.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && oxlint && eslint . --cache --cache-strategy content --concurrency=off",
		"lint:oxlint": "oxlint",
		"lint:eslint": "eslint . --cache --cache-strategy content --concurrency=off",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"lint:deps": "depcruise --config .dependency-cruiser.cjs src",
		"lint:dead": "knip --no-progress",
		"arch:check": "node scripts/arch/run-all.mjs",
		"storybook": "storybook dev -p 6006 --no-open",
		"storybook:build": "storybook build",
		"test:visual": "playwright test --project=visual",
		"test:visual:update": "playwright test --project=visual --update-snapshots",
		"test:a11y": "playwright test --project=a11y",
		"verify": "npm run lint && npm run lint:css && npm run lint:deps && npm run arch:check && npm run check && npm run lint:dead",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --passWithNoTests --coverage",
		"test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
		"openapi:codegen": "node scripts/openapi-codegen.mjs",
		"openapi:check": "node scripts/openapi-codegen.mjs --check",
		"size": "size-limit",
		"size:critical": "node scripts/check-bundle-size.mjs",
		"prepare": "husky"
	},
	"size-limit": [
		{
			"name": "Total CSS bundle (gzip)",
			"path": "build/client/_app/immutable/**/*.css",
			"limit": "60 KB",
			"gzip": true,
			"running": false
		},
		{
			"name": "Total cacheable JS (informational, gzip)",
			"path": "build/client/_app/immutable/**/*.js",
			"limit": "600 KB",
			"gzip": true,
			"running": false
		}
	],
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.49.0",
		"@size-limit/preset-app": "^12.1.0",
		"@storybook/addon-a11y": "^10.4.1",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/svelte": "^10.4.1",
		"@storybook/sveltekit": "^10.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@types/node": "^25.6.1",
		"@vitest/coverage-v8": "^4.1.5",
		"culori": "^4.0.2",
		"dependency-cruiser": "^17.4.2",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"knip": "^6.14.2",
		"lint-staged": "^17.0.2",
		"openapi-typescript": "^7.13.0",
		"openapi-zod-client": "^1.18.3",
		"oxlint": "^1.66.0",
		"postcss-html": "^1.8.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.0.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"size-limit": "^12.1.0",
		"storybook": "^10.4.1",
		"stylelint": "^17.12.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-declaration-strict-value": "^1.11.1",
		"stylelint-plugin-logical-css": "^2.1.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.20.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.74.0",
		"@sveltejs/adapter-node": "^6.0.4",
		"@sveltejs/kit": "^3.3.0",
		"@tanstack/svelte-query": "^6.1.29",
		"bits-ui": "^2.21.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"svelte": "^5.57.3",
		"svelte-i18n": "^4.0.1",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
