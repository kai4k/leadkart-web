{
	"name": "leadkart-web",
	"description": "LeadKart SaaS web frontend — Svelte 5 + SvelteKit 2 + Tailwind 4 SPA targeting the leadkart-go JSON API.",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "ORIGIN=http://localhost:4173 PORT=4173 node build/index.js",
		"test:mock-server": "node tests/e2e/mock-server/server.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && oxlint && eslint . --cache --cache-strategy content --concurrency=auto",
		"lint:oxlint": "oxlint",
		"lint:eslint": "eslint . --cache --cache-strategy content --concurrency=auto",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"lint:deps": "depcruise --config .dependency-cruiser.cjs src",
		"lint:dead": "knip --no-progress",
		"arch:check": "node scripts/arch/run-all.mjs",
		"storybook": "storybook dev -p 6006 --no-open",
		"storybook:build": "storybook build",
		"test:visual": "playwright test --project=visual",
		"test:visual:update": "playwright test --project=visual --update-snapshots",
		"test:a11y": "playwright test --project=a11y",
		"verify": "npm run lint && npm run lint:css && npm run lint:deps && npm run arch:check && npm run check && npm run lint:dead",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --passWithNoTests --coverage",
		"test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
		"openapi:types": "openapi-typescript ../leadkart-go/api/openapi.yaml -o src/lib/api/generated/openapi-types.ts",
		"openapi:zod": "openapi-zod-client ../leadkart-go/api/openapi.yaml -o src/lib/api/generated/openapi-zod.ts --export-schemas && node scripts/strip-zodios.mjs src/lib/api/generated/openapi-zod.ts",
		"openapi:codegen": "npm run openapi:types && npm run openapi:zod",
		"openapi:check": "npm run openapi:codegen && git diff --exit-code src/lib/api/generated/",
		"size": "size-limit",
		"prepare": "husky"
	},
	"size-limit": [
		{
			"name": "Total JS bundle (gzip)",
			"path": "build/client/_app/immutable/**/*.js",
			"limit": "350 KB",
			"gzip": true,
			"running": false
		},
		{
			"name": "Total CSS bundle (gzip)",
			"path": "build/client/_app/immutable/**/*.css",
			"limit": "60 KB",
			"gzip": true,
			"running": false
		},
		{
			"name": "Initial route entry (signin)",
			"path": "build/client/_app/immutable/entry/**/*.js",
			"limit": "60 KB",
			"gzip": true,
			"running": false
		}
	],
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.49.0",
		"@size-limit/preset-app": "^12.1.0",
		"@storybook/addon-a11y": "^10.4.1",
		"@storybook/addon-essentials": "^8.6.14",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/svelte": "^10.4.1",
		"@storybook/sveltekit": "^10.4.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.0",
		"@types/node": "^25.6.1",
		"@vitest/coverage-v8": "^4.1.5",
		"ajv": "^8.20.0",
		"colord": "^2.9.3",
		"culori": "^4.0.2",
		"dependency-cruiser": "^17.4.2",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"knip": "^6.14.2",
		"lint-staged": "^17.0.2",
		"openapi-typescript": "^7.13.0",
		"openapi-zod-client": "^1.18.3",
		"oxlint": "^1.66.0",
		"postcss-html": "^1.8.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.0.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"serve": "^14.2.6",
		"size-limit": "^12.1.0",
		"storybook": "^10.4.1",
		"stylelint": "^17.12.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-declaration-strict-value": "^1.11.1",
		"stylelint-plugin-logical-css": "^2.1.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.20.0",
		"valibot": "^1.4.0",
		"vite": "^8.0.11",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@tanstack/svelte-query": "^6.1.29",
		"bits-ui": "^2.18.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"svelte-i18n": "^4.0.1",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.4.3"
	}
}
